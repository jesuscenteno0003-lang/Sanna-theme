<!-- ================================================================
     REPISA — HOMEPAGE
     Multi-brand beauty marketplace
     ================================================================ -->

<div class="repisa-homepage">
  <!-- HERO SECTION -->
  <section class="repisa-hero">
    <div class="repisa-hero-bg">
      {% if section.settings.hero_image %}
        <img src="{{ section.settings.hero_image | image_url: width: 1920 }}" alt="{{ section.settings.hero_title }}" loading="eager">
      {% else %}
        <img src="{{ 'hero-bg.svg' | asset_url }}" alt="REPISA Belleza" loading="eager">
      {% endif %}
    </div>
    <div class="repisa-hero-overlay"></div>
    <div class="repisa-hero-content">
      {% if section.settings.hero_subtitle != blank %}
        <span class="text-uppercase">{{ section.settings.hero_subtitle }}</span>
      {% endif %}
      {% if section.settings.hero_title != blank %}
        <h1>{{ section.settings.hero_title }}</h1>
      {% endif %}
      {% if section.settings.hero_description != blank %}
        <p>{{ section.settings.hero_description }}</p>
      {% endif %}
      <div style="display: flex; gap: 16px; flex-wrap: wrap;">
        <a href="{{ section.settings.hero_button_url | default: '/collections' }}" class="btn btn-gold">
          {{ section.settings.hero_button_text | default: 'Explorar Colecciones' }}
        </a>
        <a href="{{ section.settings.hero_secondary_url | default: '/pages/nuestras-marcas' }}" class="btn btn-white">
          {{ section.settings.hero_secondary_text | default: 'Nuestras Marcas' }}
        </a>
      </div>
    </div>
  </section>

  <!-- BRAND MARQUEE -->
  <section class="brand-marquee">
    <div class="brand-marquee-track">
      <span class="brand-marquee-item">La Roche-Posay</span>
      <span class="brand-marquee-item">CeraVe</span>
      <span class="brand-marquee-item">The Ordinary</span>
      <span class="brand-marquee-item">Paula's Choice</span>
      <span class="brand-marquee-item">Drunk Elephant</span>
      <span class="brand-marquee-item">Tatcha</span>
      <span class="brand-marquee-item">Glossier</span>
      <span class="brand-marquee-item">Charlotte Tilbury</span>
      <span class="brand-marquee-item">Rare Beauty</span>
      <span class="brand-marquee-item">Sol de Janeiro</span>
      <!-- Duplicated for seamless loop -->
      <span class="brand-marquee-item">La Roche-Posay</span>
      <span class="brand-marquee-item">CeraVe</span>
      <span class="brand-marquee-item">The Ordinary</span>
      <span class="brand-marquee-item">Paula's Choice</span>
      <span class="brand-marquee-item">Drunk Elephant</span>
      <span class="brand-marquee-item">Tatcha</span>
      <span class="brand-marquee-item">Glossier</span>
      <span class="brand-marquee-item">Charlotte Tilbury</span>
      <span class="brand-marquee-item">Rare Beauty</span>
      <span class="brand-marquee-item">Sol de Janeiro</span>
    </div>
  </section>

  <!-- FEATURED COLLECTIONS -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="text-uppercase">Explora por Categoría</span>
        <h2>Encuentra tu ritual</h2>
      </div>
      
      <div class="collection-grid">
        {% for block in section.blocks limit: 6 %}
          {% if block.type == 'collection' %}
            {% assign coll = collections[block.settings.collection] %}
            {% assign img_src = '' %}
            {% if block.settings.image %}
              {% assign img_src = block.settings.image | image_url: width: 600 %}
            {% elsif coll.image %}
              {% assign img_src = coll.image | image_url: width: 600 %}
            {% else %}
              {% assign img_src = 'collection-' | append: block.settings.collection | append: '.svg' | asset_url %}
            {% endif %}
            <a href="/collections/{{ block.settings.collection }}" class="collection-card" {{ block.shopify_attributes }}>
              <img src="{{ img_src }}" alt="{{ block.settings.title }}" loading="lazy">
              <div class="collection-card-overlay">
                <h3 class="collection-card-title">{{ block.settings.title | default: coll.title }}</h3>
                <span class="collection-card-count">{{ coll.products_count }} productos</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  {% assign featured_collection = collections[section.settings.featured_collection] %}
  {% if featured_collection != blank %}
    <section class="section section-cream">
      <div class="container">
        <div class="section-header">
          <span class="text-uppercase">Lo Más Popular</span>
          <h2>{{ section.settings.featured_title | default: 'Favoritos de Nuestra Comunidad' }}</h2>
          <p>{{ section.settings.featured_description | default: 'Los productos que nuestros clientes aman y recomiendan.' }}</p>
        </div>
        
        <div class="product-grid">
          {% for product in featured_collection.products limit: 8 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
        
        <div class="text-center mt-2xl">
          <a href="{{ featured_collection.url }}" class="btn btn-secondary">Ver Todos los Productos</a>
        </div>
      </div>
    </section>
  {% endif %}

  <!-- VALUE PROPOSITIONS -->
  <section class="section">
    <div class="container">
      <div class="value-props">
        <div class="value-prop">
          <div class="value-prop-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
          <h4 class="value-prop-title">Envío Gratis</h4>
          <p class="value-prop-text">En todos los pedidos superiores a S/.200</p>
        </div>
        
        <div class="value-prop">
          <div class="value-prop-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h4 class="value-prop-title">100% Auténtico</h4>
          <p class="value-prop-text">Solo marcas originales y verificadas</p>
        </div>
        
        <div class="value-prop">
          <div class="value-prop-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
          </div>
          <h4 class="value-prop-title">3 Cuotas Sin Interés</h4>
          <p class="value-prop-text">Paga cómodo con Tarjeta Repisa</p>
        </div>
        
        <div class="value-prop">
          <div class="value-prop-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
          </div>
          <h4 class="value-prop-title">Devolución Fácil</h4>
          <p class="value-prop-text">30 días para cambios sin preguntas</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="newsletter">
    <div class="container">
      <span class="text-uppercase" style="color: var(--r-gold);">Únete al Club</span>
      <h2>Beauty Club REPISA</h2>
      <p>Acceso anticipado a lanzamientos, descuentos exclusivos y contenido de belleza directo a tu correo.</p>
      
      <form class="newsletter-form" action="/contact#newsletter" method="post">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="newsletter-input" placeholder="Tu correo electrónico" required>
        <button type="submit" class="newsletter-submit">Suscribirme</button>
      </form>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "REPISA Homepage",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Nueva Colección"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Tu estante de belleza curado"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Descubre las mejores marcas de skincare, maquillaje y fragancias. Envío gratis en pedidos +S/.200."
    },
    {
      "type": "text",
      "id": "hero_button_text",
      "label": "Hero Button Text",
      "default": "Explorar Colecciones"
    },
    {
      "type": "url",
      "id": "hero_button_url",
      "label": "Hero Button URL"
    },
    {
      "type": "text",
      "id": "hero_secondary_text",
      "label": "Hero Secondary Button Text",
      "default": "Nuestras Marcas"
    },
    {
      "type": "url",
      "id": "hero_secondary_url",
      "label": "Hero Secondary Button URL"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured Collection"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured Section Title",
      "default": "Favoritos de Nuestra Comunidad"
    },
    {
      "type": "textarea",
      "id": "featured_description",
      "label": "Featured Section Description",
      "default": "Los productos que nuestros clientes aman y recomiendan."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "REPISA Homepage",
      "blocks": [
        {
          "type": "collection",
          "settings": {
          }
        },
        {
          "type": "collection",
          "settings": {
          }
        },
        {
          "type": "collection",
          "settings": {
          }
        }
      ]
    }
  ]
}
{% endschema %}
