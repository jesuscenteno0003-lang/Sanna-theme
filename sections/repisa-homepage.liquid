<!-- ================================================================
     REPISA — HOMEPAGE
     Multi-brand beauty marketplace
     ================================================================ -->

<div class="repisa-homepage">
  <!-- HERO SECTION - Premium Beauty Marketplace -->
  <section class="repisa-hero">
    <div class="repisa-hero-bg">
      {% if section.settings.hero_image %}
        <img src="{{ section.settings.hero_image | image_url: width: 1920 }}" alt="{{ section.settings.hero_title }}" loading="eager">
      {% else %}
        <img src="https://images.unsplash.com/photo-1748543668676-ea8241cb3886?w=1920&q=80&auto=format&fit=crop" alt="REPISA Belleza - Skincare Premium" loading="eager">
      {% endif %}
    </div>
    <div class="repisa-hero-overlay"></div>
    <div class="repisa-hero-content">
      {% if section.settings.hero_subtitle != blank %}
        <span class="text-uppercase hero-animate hero-animate-1">{{ section.settings.hero_subtitle }}</span>
      {% endif %}
      {% if section.settings.hero_title != blank %}
        <h1 class="hero-animate hero-animate-2">{{ section.settings.hero_title }}</h1>
      {% endif %}
      {% if section.settings.hero_description != blank %}
        <p class="hero-animate hero-animate-3">{{ section.settings.hero_description }}</p>
      {% endif %}
      <div class="hero-buttons hero-animate hero-animate-4">
        <a href="{{ section.settings.hero_button_url | default: '/collections' }}" class="btn btn-gold">
          {{ section.settings.hero_button_text | default: 'Descubrir Ahora' }}
        </a>
        <a href="{{ section.settings.hero_secondary_url | default: '/pages/nuestras-marcas' }}" class="btn btn-white">
          {{ section.settings.hero_secondary_text | default: 'Ver Marcas' }}
        </a>
      </div>
    </div>
    <div class="hero-scroll-indicator">
      <span>Descubre más</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- BRAND MARQUEE -->
  <section class="brand-marquee">
    <div class="brand-marquee-track">
      <span class="brand-marquee-item">La Roche-Posay</span>
      <span class="brand-marquee-item">CeraVe</span>
      <span class="brand-marquee-item">The Ordinary</span>
      <span class="brand-marquee-item">Paula's Choice</span>
      <span class="brand-marquee-item">Drunk Elephant</span>
      <span class="brand-marquee-item">Tatcha</span>
      <span class="brand-marquee-item">Glossier</span>
      <span class="brand-marquee-item">Charlotte Tilbury</span>
      <span class="brand-marquee-item">Rare Beauty</span>
      <span class="brand-marquee-item">Sol de Janeiro</span>
      <!-- Duplicated for seamless loop -->
      <span class="brand-marquee-item">La Roche-Posay</span>
      <span class="brand-marquee-item">CeraVe</span>
      <span class="brand-marquee-item">The Ordinary</span>
      <span class="brand-marquee-item">Paula's Choice</span>
      <span class="brand-marquee-item">Drunk Elephant</span>
      <span class="brand-marquee-item">Tatcha</span>
      <span class="brand-marquee-item">Glossier</span>
      <span class="brand-marquee-item">Charlotte Tilbury</span>
      <span class="brand-marquee-item">Rare Beauty</span>
      <span class="brand-marquee-item">Sol de Janeiro</span>
    </div>
  </section>

  <!-- FEATURED COLLECTIONS -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="text-uppercase">Explora por Categoría</span>
        <h2>Encuentra tu ritual</h2>
      </div>
      
      <div class="collection-grid">
        {% for block in section.blocks limit: 6 %}
          {% if block.type == 'collection' %}
            {% assign coll = collections[block.settings.collection] %}
            {% assign img_src = '' %}
            {% if block.settings.image %}
              {% assign img_src = block.settings.image | image_url: width: 600 %}
            {% elsif coll.image %}
              {% assign img_src = coll.image | image_url: width: 600 %}
            {% else %}
              {% case block.settings.collection %}
                {% when 'skincare' %}
                  {% assign img_src = 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?w=600&q=80&auto=format&fit=crop' %}
                {% when 'maquillaje' %}
                  {% assign img_src = 'https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=600&q=80&auto=format&fit=crop' %}
                {% when 'fragancias' %}
                  {% assign img_src = 'https://images.unsplash.com/photo-1541643600914-78b084683601?w=600&q=80&auto=format&fit=crop' %}
                {% when 'cuidado-capilar' %}
                  {% assign img_src = 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=600&q=80&auto=format&fit=crop' %}
                {% when 'accesorios' %}
                  {% assign img_src = 'https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?w=600&q=80&auto=format&fit=crop' %}
                {% when 'novedades' %}
                  {% assign img_src = 'https://images.unsplash.com/photo-1571781926291-c477ebfd024b?w=600&q=80&auto=format&fit=crop' %}
                {% when 'sale', 'aromaterapia' %}
                  {% assign img_src = 'https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?w=600&q=80&auto=format&fit=crop' %}
                {% else %}
                  {% assign img_src = 'https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=600&q=80&auto=format&fit=crop' %}
              {% endcase %}
            {% endif %}
            <a href="/collections/{{ block.settings.collection }}" class="collection-card" {{ block.shopify_attributes }}>
              <img src="{{ img_src }}" alt="{{ block.settings.title }}" loading="lazy">
              <div class="collection-card-overlay">
                <h3 class="collection-card-title">{{ block.settings.title | default: coll.title }}</h3>
                <span class="collection-card-count">{{ coll.products_count }} productos</span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  {% assign featured_collection = collections[section.settings.featured_collection] %}
  {% if featured_collection != blank %}
    <section class="section section-cream">
      <div class="container">
        <div class="section-header">
          <span class="text-uppercase">Lo Más Popular</span>
          <h2>{{ section.settings.featured_title | default: 'Favoritos de Nuestra Comunidad' }}</h2>
          <p>{{ section.settings.featured_description | default: 'Los productos que nuestros clientes aman y recomiendan.' }}</p>
        </div>
        
        <div class="product-grid">
          {% for product in featured_collection.products limit: 8 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
        
        <div class="text-center mt-2xl">
          <a href="{{ featured_collection.url }}" class="btn btn-secondary">Ver Todos los Productos</a>
        </div>
      </div>
    </section>
  {% endif %}

  <!-- VALUE PROPOSITIONS -->
  <section class="section">
    <div class="container">
      <div class="value-props">
        <div class="value-prop">
          <div class="value-prop-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
          <h4 class="value-prop-title">Envío Gratis</h4>
          <p class="value-prop-text">En todos los pedidos superiores a S/.200</p>
        </div>
        
        <div class="value-prop">
          <div class="value-prop-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h4 class="value-prop-title">100% Auténtico</h4>
          <p class="value-prop-text">Solo marcas originales y verificadas</p>
        </div>
        
        <div class="value-prop">
          <div class="value-prop-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
          </div>
          <h4 class="value-prop-title">3 Cuotas Sin Interés</h4>
          <p class="value-prop-text">Paga cómodo con Tarjeta Repisa</p>
        </div>
        
        <div class="value-prop">
          <div class="value-prop-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
          </div>
          <h4 class="value-prop-title">Devolución Fácil</h4>
          <p class="value-prop-text">30 días para cambios sin preguntas</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BEAUTY ROUTINE -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="text-uppercase">Tu Ritual Diario</span>
        <h2>Pasos para una piel perfecta</h2>
      </div>
      
      <div class="routine-steps">
        <div class="routine-step">
          <div class="routine-step-number">01</div>
          <div class="routine-step-image">
            <img src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?w=400&q=80&auto=format&fit=crop" alt="Limpieza">
          </div>
          <h3 class="routine-step-title">Limpieza</h3>
          <p class="routine-step-text">Remueve impurezas y prepara tu piel para los tratamientos siguientes.</p>
        </div>
        
        <div class="routine-step">
          <div class="routine-step-number">02</div>
          <div class="routine-step-image">
            <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=400&q=80&auto=format&fit=crop" alt="Tónico">
          </div>
          <h3 class="routine-step-title">Tónico</h3>
          <p class="routine-step-text">Equilibra el pH y retrata los poros para una apariencia más uniforme.</p>
        </div>
        
        <div class="routine-step">
          <div class="routine-step-number">03</div>
          <div class="routine-step-image">
            <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=400&q=80&auto=format&fit=crop" alt="Serum">
          </div>
          <h3 class="routine-step-title">Sérum</h3>
          <p class="routine-step-text">Concentrado de activos que tratan preocupaciones específicas de tu piel.</p>
        </div>
        
        <div class="routine-step">
          <div class="routine-step-number">04</div>
          <div class="routine-step-image">
            <img src="https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd?w=400&q=80&auto=format&fit=crop" alt="Hidratación">
          </div>
          <h3 class="routine-step-title">Hidratación</h3>
          <p class="routine-step-text">Sella los activos y mantiene tu piel hidratada durante todo el día.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section-cream">
    <div class="container">
      <div class="section-header">
        <span class="text-uppercase">Lo Que Dicen Nuestras Clientas</span>
        <h2>Opiniones reales</h2>
      </div>
      
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"El sérum de vitamina C cambió mi piel por completo. Las manchas se aclararon en 3 semanas. ¡Lo recomiendo totalmente!"</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">MC</div>
            <div>
              <strong>María C.</strong>
              <span>Lima, Perú</span>
            </div>
          </div>
        </div>
        
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"Excelente atención y productos originales. El envío llegó rápido y bien empacado. Mi crema favorita ahora la consigo aquí."</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">AG</div>
            <div>
              <strong>Ana G.</strong>
              <span>Arequipa, Perú</span>
            </div>
          </div>
        </div>
        
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"Las fragancias son increíbles. Compré perfume de Jo Malone y es 100% auténtico. Precios muy competitivos."</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">LR</div>
            <div>
              <strong>Luisa R.</strong>
              <span>Trujillo, Perú</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

